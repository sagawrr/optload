{
  "name": "@optload/browser",
  "version": "1.0.0",
  "description": "Effect-powered browser image intake with Promise-first and native Effect APIs.",
  "type": "module",
  "sideEffects": [
    "**/dist/worker.js"
  ],
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./effect": {
      "types": "./dist/effect.d.ts",
      "import": "./dist/effect.js"
    }
  },
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc -b --pretty false",
    "prepublishOnly": "pnpm run build"
  },
  "dependencies": {
    "@optload/core": "workspace:*",
    "effect": "3.22.1"
  },
  "license": "MIT",
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sagawrr/optload.git",
    "directory": "packages/browser"
  },
  "bugs": {
    "url": "https://github.com/sagawrr/optload/issues"
  },
  "homepage": "https://github.com/sagawrr/optload/tree/main/packages/browser#readme",
  "keywords": [
    "image",
    "upload",
    "resize",
    "webp",
    "worker",
    "security",
    "effect"
  ]
}
