{
  "name": "@optload/browser",
  "version": "0.1.0",
  "description": "Effect-powered browser image intake with Promise-first and native Effect APIs.",
  "type": "module",
  "sideEffects": [
    "**/dist/worker.js"
  ],
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./effect": {
      "types": "./dist/effect.d.ts",
      "import": "./dist/effect.js"
    }
  },
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc -b --pretty false"
  },
  "dependencies": {
    "@optload/core": "workspace:*",
    "effect": "3.22.1"
  },
  "license": "MIT",
  "keywords": [
    "image",
    "upload",
    "resize",
    "webp",
    "worker",
    "security",
    "effect"
  ]
}
