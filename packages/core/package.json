{
  "name": "@optload/core",
  "version": "1.0.0",
  "description": "Effect-native image inspection and policy primitives for Optload.",
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc -b --pretty false",
    "prepublishOnly": "pnpm run build"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "effect": "3.22.1"
  },
  "license": "MIT",
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sagawrr/optload.git",
    "directory": "packages/core"
  },
  "bugs": {
    "url": "https://github.com/sagawrr/optload/issues"
  },
  "homepage": "https://github.com/sagawrr/optload/tree/main/packages/core#readme",
  "keywords": [
    "image",
    "upload",
    "security",
    "magic-bytes",
    "policy",
    "effect"
  ]
}
