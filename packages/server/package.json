{
  "name": "@optload/server",
  "version": "1.0.0",
  "description": "Effect-powered server image verification with Promise-first and native Effect APIs.",
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./effect": {
      "types": "./dist/effect.d.ts",
      "import": "./dist/effect.js"
    }
  },
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc -b --pretty false",
    "prepublishOnly": "pnpm run build"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@optload/core": "workspace:*",
    "effect": "3.22.1"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sagawrr/optload.git",
    "directory": "packages/server"
  },
  "bugs": {
    "url": "https://github.com/sagawrr/optload/issues"
  },
  "homepage": "https://github.com/sagawrr/optload/tree/main/packages/server#readme",
  "keywords": [
    "image",
    "upload",
    "validation",
    "security",
    "normalizer",
    "effect"
  ]
}
