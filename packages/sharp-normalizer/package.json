{
  "name": "@optload/sharp-normalizer",
  "version": "1.0.0",
  "description": "Process-isolated sharp decoder adapter implementing the Optload server normalizer contract.",
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist",
    "LICENSE"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./effect": {
      "types": "./dist/effect.d.ts",
      "import": "./dist/effect.js"
    }
  },
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc -b --pretty false",
    "prepublishOnly": "pnpm run build"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@optload/core": "workspace:*",
    "@optload/server": "workspace:*",
    "effect": "3.22.1",
    "sharp": "0.35.4"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sagawrr/optload.git",
    "directory": "packages/sharp-normalizer"
  },
  "bugs": {
    "url": "https://github.com/sagawrr/optload/issues"
  },
  "homepage": "https://github.com/sagawrr/optload/tree/main/packages/sharp-normalizer#readme",
  "keywords": [
    "image",
    "sharp",
    "libvips",
    "normalizer",
    "optload",
    "security"
  ],
  "devDependencies": {
    "@types/node": "^24.0.0"
  }
}
